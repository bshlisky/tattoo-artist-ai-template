# =============================================================================
# TAETU AI TATTOO GENERATOR - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual API keys
# 
# SECURITY: Never commit .env.local to git (it's already in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# THEME SELECTION
# -----------------------------------------------------------------------------
# Choose between "dreadmoor" (dark gothic) or "taetu" (clean professional)
# Default: dreadmoor
# -----------------------------------------------------------------------------
NEXT_PUBLIC_THEME=dreadmoor

# -----------------------------------------------------------------------------
# REQUIRED: OpenAI API Key
# -----------------------------------------------------------------------------
# Used for: Chat conversations (GPT-5-nano) and image analysis (vision model)
# Get it from: https://platform.openai.com/api-keys
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cost: ~$0.15 per 1M tokens (pay-as-you-go)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# REQUIRED: Replicate API Token
# -----------------------------------------------------------------------------
# Used for: Tattoo image generation (Flux models)
# Get it from: https://replicate.com/account/api-tokens
# Format: r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cost: ~$0.03-0.10 per image generation (pay-per-use)
# -----------------------------------------------------------------------------
REPLICATE_API_TOKEN=your_replicate_api_token_here

# -----------------------------------------------------------------------------
# OPTIONAL: Supabase Configuration
# -----------------------------------------------------------------------------
# Used for: Location-based tattoo artist recommendations
# Get it from: https://supabase.com (create a project)
# Note: App works fine without these - uses hardcoded artist list instead
# Cost: Free tier available
# -----------------------------------------------------------------------------
# SUPABASE_URL=your_supabase_project_url_here
# SUPABASE_KEY=your_supabase_service_role_key_here

# =============================================================================
# SETUP INSTRUCTIONS:
# =============================================================================
# 1. Copy this file: cp .env.local.template .env.local
# 2. Edit .env.local and replace the placeholder values with your actual keys
# 3. Remove the # from SUPABASE lines if you want location-based features
# 4. Save the file
# 5. Restart your development server: npm run dev
# =============================================================================
